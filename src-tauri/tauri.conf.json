{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jaune",
  "version": "0.1.0",
  "identifier": "com.ericbstie.jaune",
  "build": {
    "beforeDevCommand": "mise run web:dev",
    "beforeBuildCommand": "mise run web:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Jaune", "width": 800, "height": 600 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:"
    }
  },
  "bundle": { "active": false }
}
